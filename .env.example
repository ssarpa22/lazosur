NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Neon pooled connection string for the least-privilege lazo_sur_app role.
# Never use the owner connection string in the application.
DATABASE_URL=
# Direct/unpooled connection string for manual migrations only; not used at runtime.
DATABASE_URL_UNPOOLED=

# Neon Auth server configuration
NEON_AUTH_BASE_URL=
NEON_AUTH_COOKIE_SECRET=

# Server-only comma-separated administrator allowlist
ADMIN_EMAILS=

# Upstash Redis REST credentials (server-only)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
